# Feedstock recipe for xml2rfc
# spec 13 §9 + docs/conventions.md in tebako-packages/index
name: "xml2rfc"
kind: app
summary: "xml2rfc — the IETF RFC/XML authoring renderer (python app; runtime-required payload)"

upstream:
  # PyPI closure, not a tarball: the dependency set is resolved from PyPI
  # by tools/build (the pip analog of the metanorma feedstock's rubygems
  # closure rule) and every wheel/sdist is sha256-verified before use.
  # The locked closure with hashes is generated, never hand-authored:
  # closure/<version>-<triplet>.txt (metanorma pattern).
  pypi: "xml2rfc"
  version: "3.34.1"          # PyPI-verified latest, 2026-09-14
  source: "https://pypi.org"
  # requires_python >= 3.10 (PyPI-verified); upstream classifiers cover
  # python 3.14. The MANIFEST's runtime edge is the ABI line (~> 3.14.0),
  # not this range — the payload carries lxml/markupsafe C extensions, so
  # spec 05 §5's native-extension law applies: wrong line = named error,
  # never a segfault. This range documents the pure-language floor only.

build:
  system: pipstage         # stage a pip --target closure with a tebako runtime's own python
  runtime:
    engine: python
    version: "3.14.7"      # the staging + exec runtime (the ONE line every leg
                           # rides — the ABI edge stays uniform: the factory's
                           # windows-ucrt64 leg exists only for this line, the
                           # source factory ships no 3.13 windows-msys asset)
    tebako: "0.2.6"        # the runtime package's <ver> (the factory's
                           # VERSION). 0.2.3 is the materialize-tier line
                           # that BOOTS on windows (the fs TU follows the
                           # rewired TEBAKO_MOUNT_ROOT) AND ships the msys
                           # _ctypes extension (libffi static) the xml2rfc
                           # closure imports at boot:
                           # the shard model (per-package manifest shards +
                           # per-asset .sha256 sidecars + OpenPGP .asc
                           # signatures, NO monolithic manifest.json /
                           # SHA256SUMS.txt — tools/stage_runtime derives
                           # the trimmed monoliths consumer-side) plus
                           # `windows_boot: materialize` on the msys env
                           # image, so a windows payload boots on its own
                           # platform.
    # RELEASE CHANNEL: the staging runtime and the CI test legs resolve the
    # factory RELEASE — tools/stage_runtime's release channel enumerates the
    # pinned tag's shards (gh release view), fetches the assets each shard
    # names, verifies every staged byte three ways (per-asset .sha256
    # sidecar ↔ staged bytes ↔ the shard's own digest fields + the filename
    # identity), and derives the TRIMMED manifest.json + SHA256SUMS.txt into
    # a file:// runtime mirror (spec 05 §2's download-base shape; tebako
    # resolves runtimes by TEBAKO_RUNTIME_MIRROR + the config.yaml
    # `runtimes:` pin — spec 04 §2's kind:runtime registry entries remain
    # PLANNED). NEVER a hand-installed python. The run-artifacts channel
    # remains selectable by env override for pre-publish factory builds only.
    channel: release       # release (published factory tag) | run-artifacts (pre-publish proof builds)
    release: "v0.2.6"      # the factory release tag (release channel)
  # The closure's native members (lxml — C extension, per-triplet wheels,
  # musl = musllinux; markupsafe / pyyaml optional C speedups): staged
  # from PyPI wheels matching the staging runtime's ABI tag (cp314) and
  # the leg's triplet — the wheel-tag ↔ ABI-line mapping audit runs
  # fail-closed in tools/gen_closure. Source builds of native members are
  # NEVER a feedstock path (no compilation machinery for audiences 1-3).
  native_members: ["lxml", "markupsafe", "pyyaml"]

platforms:
  # the tebako-runtime-python matrix's POSIX six plus the windows-ucrt
  # leg, which rides the factory's v0.2.6 materialize tier
  # (`windows_boot: materialize` on the msys env image — the driver
  # extracts the mounted+verified images into the exec cache, so a
  # windows payload boots on its own platform). The line choice (3.14.7)
  # keeps the ABI edge uniform: the factory's windows-ucrt64 runtime
  # exists only on the 3.14 line.
  - x86_64-linux-gnu
  - aarch64-linux-gnu
  - x86_64-linux-musl
  - aarch64-linux-musl
  - x86_64-macos
  - aarch64-macos
  - x86_64-windows-ucrt

provides:
  entrypoints:
    - {name: "xml2rfc", path: "/bin/xml2rfc", version: "3.34.1"}
  executables: []          # no host-tier executables: the console script
                           # needs the interpreter (spec 32's spawn form)

ci:
  # The leg topology (host runner per triplet): the tebako-runtime-python
  # factory's matrix. The linux legs run on the ubuntu host and
  # docker-run the pinned tpkg-builder image per triplet-matched step —
  # the musl image is alpine-based and node actions cannot run on musl
  # (the factory's _build-platform.yml grammar). The windows leg is
  # runner-native (no container; git-bash supplies curl/sha256sum/ruby).
  hosts:
    x86_64-linux-gnu: "ubuntu-22.04"
    aarch64-linux-gnu: "ubuntu-22.04-arm"
    x86_64-linux-musl: "ubuntu-22.04"
    aarch64-linux-musl: "ubuntu-22.04-arm"
    x86_64-macos: "macos-15-intel"
    aarch64-macos: "macos-14"
    x86_64-windows-ucrt: "windows-latest"
  # Pinned BY DIGEST (tebako-ci-containers README: consumers pin by
  # digest; the v1 tag is the baked alpine 3.21 provisioning). Only the
  # musl legs docker-run — the gnu runtime exe executes on the ubuntu
  # host's own glibc (no compilation anywhere in this feedstock).
  containers:
    x86_64-linux-musl: "ghcr.io/tamatebako/tpkg-builder-x86_64-linux-musl@sha256:415db3a92771404d13e8c6276327d0df978a8bacccaee24c056e1f7890d9aae8"
    aarch64-linux-musl: "ghcr.io/tamatebako/tpkg-builder-aarch64-linux-musl@sha256:0e6711a7ad7668875df752bc07ef9097fc026797bc93da8de0d704810a1be137"

