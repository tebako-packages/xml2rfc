#!/usr/bin/env bash
# tools/boot_smoke <image.tfs> — the release gate (conventions.md):
# assert the entrypoint exists in the image and the payload's spec-26
# checks run green through the pinned tebako python runtime.
#
# Legs:
#   1. in-process image assertions (the tfs CLI): the entrypoint stub,
#      the site-packages tree, the embedded manifest, the check fixture.
#   2. the spec-26 press-time gate: `tebako check <image> --runtime <exe>
#      --runtime-image <env.tfs>` — the manifest's checks: block (version
#      + render-txt) executed by the v2.2.0 engine; FAIL is the engine's
#      named exit 79.
#   3. the manual spec-17 dispatch smoke (the wire the spec-32 spawn
#      composes): the runtime exe with the payload mounted bare at "/",
#      TEBAKO_RUNTIME_IMAGE for the env image, --tebako-entry
#      /bin/xml2rfc --version — proves the handoff independent of the
#      check engine.
#
# Env: TFS (tfs CLI), TEBAKO (tebako CLI), RUNTIME (the runtime exe),
#      RUNTIME_IMAGE (the env .tfs) — tools/build writes all four into
#      out/<triplet>/runtime.env (absolute spellings; the check driver
#      runs with cwd = its scratch dir).
set -euo pipefail

IMG="${1:?usage: tools/boot_smoke <image.tfs>}"
TFS="${TFS:-tfs}"
TEBAKO="${TEBAKO:-tebako}"
RUNTIME="${RUNTIME:?set RUNTIME to the tebako runtime exe (tools/build writes out/<triplet>/runtime.env)}"
RUNTIME_IMAGE="${RUNTIME_IMAGE:?set RUNTIME_IMAGE to the runtime env .tfs}"

FEEDSTOCK="$(cd "$(dirname "$0")/.." && pwd)"
# Native windows tools (ruby, the tebako/tfs CLIs, the runtime exe)
# cannot read Git Bash's POSIX path spellings — FEEDSTOCK goes
# windows-form where cygpath exists (inert on POSIX; the stage_runtime
# pattern).
if command -v cygpath >/dev/null 2>&1; then FEEDSTOCK="$(cygpath -m "$FEEDSTOCK")"; fi
recipe() { ruby -ryaml -e "puts(YAML.load_file('$FEEDSTOCK/Tebakofile').dig(*ARGV) || '')" "$@"; }
PKG_V="${PKG_V:-$(recipe upstream version)}"

# On Git Bash the native CLIs (tfs, tebako, the runtime exe) receive
# their arguments VERBATIM: MSYS2's argument path-conversion would
# rewrite the in-image spellings (/bin/xml2rfc, the "/" mount) into host
# paths. Suppress it and hand the host-path arguments windows-form
# spellings instead (inert on POSIX).
if command -v cygpath >/dev/null 2>&1; then
  export MSYS2_ARG_CONV_EXCL="*"
  IMG="$(cygpath -m "$IMG")"
  RUNTIME="$(cygpath -m "$RUNTIME")"
  RUNTIME_IMAGE="$(cygpath -m "$RUNTIME_IMAGE")"
fi

echo "== entrypoint assertions (in-process mount via the tfs CLI)"
"$TFS" stat "$IMG" /bin/xml2rfc | grep -q File
"$TFS" stat "$IMG" /__tpkg__/manifest.yaml | grep -q File
"$TFS" stat "$IMG" /__tpkg__/check/render-txt/mini.xml | grep -q File
"$TFS" ls "$IMG" /lib/python/site-packages | grep -q "xml2rfc-$PKG_V.dist-info"
echo "   /bin/xml2rfc, manifest, check fixture, site-packages: present"

echo "== extract round-trip"
X="$(mktemp -d)"
# With MSYS2's conversion suppressed the -d target must be windows-form
# for the native tfs (MSYS2 coreutils read the same spelling; inert on
# POSIX).
if command -v cygpath >/dev/null 2>&1; then X="$(cygpath -m "$X")"; fi
"$TFS" extract -d "$X" "$IMG"
[ -f "$X/bin/xml2rfc" ] || { echo "extracted entrypoint missing"; exit 1; }

# TEBAKO_DEBUG_TFS: the materialize trace (ok/error per extracted file) —
# the windows tree-boot round-trips read this when an entrypoint fails to
# land in the exec tree.
if TEBAKO_DEBUG_TFS=1 "$TEBAKO" check "$IMG" --runtime "$RUNTIME" --runtime-image "$RUNTIME_IMAGE"; then
  echo "payload checks: OK"
else
  echo "== payload checks FAILED — exec-cache forensics:"
  for trees_dir in "${TEMP:-/tmp}"/tebako-exec-*/trees "${LOCALAPPDATA:-/nonexistent}/Temp"/tebako-exec-*/trees /c/Users/*/AppData/Local/Temp/tebako-exec-*/trees; do
    [ -d "$trees_dir" ] || continue
    echo "-- $trees_dir"
    for d in "$trees_dir"/*/; do
      [ -d "$d" ] || continue
      echo "-- tree $d:"
      ls -la "$d" | head -12
      [ -d "$d/bin" ] && { echo "-- $d/bin:"; ls -la "$d/bin" | head -10; }
    done
  done
  exit 1
fi

echo "== manual spec-17 dispatch smoke (the spec-32 spawn wire)"
out="$(TEBAKO_RUNTIME_IMAGE="$RUNTIME_IMAGE" \
  "$RUNTIME" "--tebako-image=$IMG:-:/" "--tebako-entry=/bin/xml2rfc" --version)"
echo "$out" | grep -q "$PKG_V" || { echo "version smoke: $PKG_V absent from: $out"; exit 1; }
echo "   xml2rfc --version: $out"

echo "BOOT-SMOKE-OK"
